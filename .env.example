# --- Database (Neon Postgres + PostGIS + pgvector) ---
# Hosted free tier. Copy the pooled connection string from the Neon console
# (Dashboard → Connection Details) and keep ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- Auth (self-hosted mock OTP) ---
# 32+ char secret for signing session JWTs. Generate: openssl rand -base64 32
AUTH_SECRET=dev-only-change-me-please-32-chars-min
# In dev the OTP is logged to the server console by ConsoleSmsSender.
# Set to a real provider id (e.g. "twilio") in production to swap the SmsSender.
SMS_PROVIDER=console
# When true, the /verify response echoes the code for local testing convenience.
OTP_DEV_ECHO=true

# --- ML pipeline seam ---
# "stub"   -> hardcoded CLEAN_HIGH_TRUST verdict (sprint 1)
# "gemini" -> Gemini 2.5 Flash AI analysis (sprint 2)
# "http"   -> real FastAPI ML service (sprint 3)
PIPELINE_MODE=gemini
PIPELINE_HTTP_URL=http://localhost:8000

# --- Image storage (Cloudinary) ---
# Get these from: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- AI Vision (Gemini 2.5 Flash) ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- AI Thresholds (optional — sensible defaults built in) ---
# AI_CONFIDENCE_HIGH=0.75
# AI_CONFIDENCE_MEDIUM=0.50
# AI_ANALYSIS_TIMEOUT_MS=15000
# AI_RATE_LIMIT_PER_MIN=30
